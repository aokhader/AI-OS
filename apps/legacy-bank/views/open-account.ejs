<%- include('partials/head') %>
<br>
<div class="ttl"><%= labels.openSubAccount %></div>
<table cellpadding="4" cellspacing="0" border="0">
<tr><td class="note">Member <%= member.id %> &mdash; <%= member.firstName %> <%= member.lastName %></td></tr>
</table>
<% if (Object.keys(errors).length > 0) { %>
<p class="err">Please correct the errors below.</p>
<% } %>
<form method="post" action="/members/<%= member.id %>/accounts/open">
<table cellpadding="4" cellspacing="0" border="1" class="box">
<tr>
<td class="lbl"><%= labels.accountType %></td>
<td>
<select name="acct_type">
<option value=""<%= values.acct_type === '' ? ' selected' : '' %>>-- select --</option>
<% for (const t of accountTypes) { %>
<option value="<%= t %>"<%= values.acct_type === t ? ' selected' : '' %>><%= t %></option>
<% } %>
</select>
<% if (errors.acct_type) { %><span class="err"><%= errors.acct_type %></span><% } %>
</td>
</tr>
<tr>
<td class="lbl"><%= labels.initialDeposit %></td>
<td>
<input type="text" name="deposit" size="10" maxlength="12" value="<%= values.deposit %>">
<% if (errors.deposit) { %><span class="err"><%= errors.deposit %></span><% } %>
</td>
</tr>
<tr>
<td>&nbsp;</td>
<td><input type="submit" value="<%= labels.openAccount %>"> &nbsp; <a href="/members/<%= member.id %>">Cancel</a></td>
</tr>
</table>
</form>
<%- include('partials/foot') %>
