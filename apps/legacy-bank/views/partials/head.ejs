<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title><%= institution %> - <%= product %> - <%= pageTitle %></title>
<style type="text/css">
body { font-family: Verdana, Arial, Helvetica, sans-serif; font-size: 12px; background: <%= theme.pageBg %>; margin: 8px; color: #222; }
table { font-size: 12px; }
.hdr { background: <%= theme.headerBg %>; color: #ffffff; padding: 6px 10px; font-weight: bold; }
.box { background: #ffffff; border: 1px solid #99a0aa; }
.lbl { background: #dfe4ea; font-weight: bold; white-space: nowrap; }
.err { color: #a00000; font-weight: bold; }
.note { color: #555555; }
.ttl { font-size: 14px; font-weight: bold; margin: 8px 0; }
a { color: #1f3b64; }
</style>
</head>
<body>
<table width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td class="hdr"><%= institution %> &nbsp;&nbsp;|&nbsp;&nbsp; <%= product %> <%= productVersion %></td></tr>
</table>
