{
  "name": "@handsoff/legacy-bank",
  "version": "0.1.0",
  "private": true,
  "description": "Mock legacy credit-union core app (ACME CoreTeller): server-rendered, framesets, table layouts, no ids. The automation target. Shares nothing with the rest of the workspace.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
