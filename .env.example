# Copy to .env. Never commit .env. Names only here; see docs/context/02-tech-stack-and-data-model.md.

# Discovery only. Replay never reads it.
ANTHROPIC_API_KEY=

HANDSOFF_MODEL=claude-opus-5
HANDSOFF_EFFORT=high
HANDSOFF_FALLBACKS=on
HANDSOFF_PORT=4000
HANDSOFF_DATA_DIR=./data
HANDSOFF_POLICY=./config/policy.json
HANDSOFF_HEADLESS=false
HANDSOFF_MAX_STEPS=30
HANDSOFF_STEP_TIMEOUT_MS=15000
HANDSOFF_RUN_TIMEOUT_MS=600000

# Mock legacy bank app. Synthetic credentials for a mock; still keep them out of git.
LEGACY_BANK_USER=teller
LEGACY_BANK_PASS=teller-demo-password
LEGACY_BANK_PORT_A=4100
LEGACY_BANK_PORT_B=4101
LEGACY_BANK_SESSION_TTL_MS=1800000
LEGACY_BANK_ALLOW_CHAOS_HEADER=true
