# Copy to .env. Never commit .env. Names only here; see docs/context/02-tech-stack-and-data-model.md.

# ---- Discovery only. Replay never reads any of these. ----
# Which model provider `handsoff discover` uses: anthropic | google | openai | groq | openrouter |
# ollama | openai-compatible. Leave empty to use whichever key below is set, in that order.
HANDSOFF_LLM_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Any other endpoint that speaks the OpenAI chat completions protocol (provider openai-compatible).
HANDSOFF_LLM_BASE_URL=
HANDSOFF_LLM_API_KEY=
# Model id for the chosen provider. Empty = the provider's default (claude-opus-5, gemini-3.8-flash);
# openai, groq, openrouter, ollama and openai-compatible need it set.
HANDSOFF_MODEL=
# Reasoning effort: low | medium | high | xhigh | max. Forwarded to anthropic, google and openai.
HANDSOFF_EFFORT=high
# Send screenshots to the model: on | off. Empty = the provider's default (on for anthropic, google, openai).
HANDSOFF_LLM_IMAGES=
# Minimum milliseconds between two model requests. Empty = the provider's default (12500 for google's
# free tier, which allows five requests per minute; 0 elsewhere).
HANDSOFF_LLM_MIN_INTERVAL_MS=
# Anthropic only: server-side refusal fallbacks.
HANDSOFF_FALLBACKS=on

HANDSOFF_PORT=4000
HANDSOFF_DATA_DIR=./data
HANDSOFF_POLICY=./config/policy.json
HANDSOFF_HEADLESS=false
HANDSOFF_MAX_STEPS=30
HANDSOFF_STEP_TIMEOUT_MS=15000
HANDSOFF_RUN_TIMEOUT_MS=600000

# Mock legacy bank app. Synthetic credentials for a mock; still keep them out of git.
LEGACY_BANK_USER=teller
LEGACY_BANK_PASS=teller-demo-password
LEGACY_BANK_PORT_A=4100
LEGACY_BANK_PORT_B=4101
LEGACY_BANK_SESSION_TTL_MS=1800000
LEGACY_BANK_ALLOW_CHAOS_HEADER=true
